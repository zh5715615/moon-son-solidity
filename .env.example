# Existing YION used outside local/test deployments.
YION_ADDRESS=
# Legacy fallback; prefer YION_ADDRESS.
TOKEN_ADDRESS=
REWARD_POOL_ADDRESS=

# Remote testnet deployment credentials. Never commit the real values.
TESTNET_RPC_URL=
DEPLOYER_PRIVATE_KEY=

# Optional roles. Defaults to the first available deployment account.
DEALER_ADDRESS=
BULL_OWNER_ADDRESS=

# Optional safety settings for scripts/buy-and-distribute-yion.js.
YION_DISTRIBUTION_DRY_RUN=true
YION_BUY_SLIPPAGE_BPS=200
CONFIRM_YION_DISTRIBUTION=false

# Local JSON-RPC settings used by the `development` network.
RPC_HOST=127.0.0.1
RPC_PORT=8545
NETWORK_ID=*
