# Existing ERC-20 token used outside local/test deployments.
TOKEN_ADDRESS=
REWARD_POOL_ADDRESS=

# Remote testnet deployment credentials. Never commit the real values.
TESTNET_RPC_URL=
DEPLOYER_PRIVATE_KEY=

# Optional roles. Defaults to the first available deployment account.
DEALER_ADDRESS=
BULL_OWNER_ADDRESS=

# Local JSON-RPC settings used by the `development` network.
RPC_HOST=127.0.0.1
RPC_PORT=8545
NETWORK_ID=*
